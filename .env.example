# Argon web — public runtime config. Every value here ships to the browser.
# Never put a keeper key, Tiingo key, or any private value in this file or in
# the Vercel project (KEEPER_PRIVATE_KEY and TIINGO_API_KEY live on Heroku only).
#
# NEXT_PUBLIC_* values are inlined at build time. After editing .env.local,
# restart `next dev` or rebuild. On Vercel, redeploy after changing a variable.

# Live Heroku agent (FastAPI). CORS allows the Vercel origin via FRONTEND_ORIGIN.
NEXT_PUBLIC_AGENT_URL=https://argon-bd8888db5430.herokuapp.com

# Development only: serve local sample rows instead of the agent. Ignored in
# production builds. Never set alongside a real AGENT_URL.
NEXT_PUBLIC_AGENT_FIXTURE=false

# RPCs (public defaults; swap for a paid endpoint without code changes)
NEXT_PUBLIC_ARB_RPC=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RH_RPC=https://rpc.mainnet.chain.robinhood.com

# Deployed contracts (2026-10-02 redeploy with the scheduled-news pause; addresses differ per chain).
# The agent publishes the vault it manages in GET /pools; the web refuses deposits when these differ.
# Retired with zero shares: 0x9F844b4D1b28Be7413067f9d4fC08Bc276fd1C60 / 0xbAf00c0aCa440337d43495c7de661A0AC2E01e8f.
# Arbitrum One (42161)
NEXT_PUBLIC_VAULT_ARB=0xe0eb546A1F8dcEc7B124cF8fE253de34d54A6c61
NEXT_PUBLIC_REGISTRY_ARB=0x8F288a7a6E28a5d44980De19502522C376965afe
# Robinhood Chain (4663)
NEXT_PUBLIC_VAULT_RH=0x89403CA4AdB3A89A0173B7494903B4247881966f
NEXT_PUBLIC_REGISTRY_RH=0x256A61b459BFdb48B4C04DE5Ba13E0dFBC326508

# Public origin of this deployment, used in wallet metadata (WalletConnect / Coinbase).
# Empty = the page's own origin at runtime. Production: https://argon-eight.vercel.app
NEXT_PUBLIC_APP_URL=https://argon-eight.vercel.app

# WalletConnect project id (optional; injected and Coinbase wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_ID=

# Owner / keeper wallet. Unlocks the read-only keeper diagnostics panel only.
NEXT_PUBLIC_ADMIN_ADDRESS=0x9642b6D1Db5D1A3B0A61a831099568bbCbC04D4E
