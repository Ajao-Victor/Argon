# Argon web — public runtime config (spec §6). Every value ships to the browser.
# Never put a keeper key, Tiingo key, or any private value here.
#
# NEXT_PUBLIC_* values are inlined at build time. After editing .env.local,
# restart `next dev` or rebuild. No code changes are needed: every hook is
# gated on these values and activates the moment they are present.

# Agent REST base URL. Empty = the UI shows "waiting for agent telemetry".
NEXT_PUBLIC_AGENT_URL=

# Development only: serve the local sample rows instead of the agent.
# Ignored in production builds. Never set this alongside a real AGENT_URL.
NEXT_PUBLIC_AGENT_FIXTURE=false

# RPCs (fall back to the public defaults if empty)
NEXT_PUBLIC_ARB_RPC=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RH_RPC=https://rpc.mainnet.chain.robinhood.com

# Contract addresses per chain. Empty = "contracts not deployed" UI state;
# deposit and withdraw stay disabled until set.
NEXT_PUBLIC_VAULT_ARB=
NEXT_PUBLIC_REGISTRY_ARB=
NEXT_PUBLIC_VAULT_RH=
NEXT_PUBLIC_REGISTRY_RH=

# WalletConnect project id (optional; injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_ID=

# Optional: address that sees the read-only keeper panel
NEXT_PUBLIC_ADMIN_ADDRESS=
